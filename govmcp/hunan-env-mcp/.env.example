# 湖南省生态环境厅实时空气 API 账号（用户名默认 hnapp）
HUNAN_AIR_API_USER=hnapp
# 密码：从官网首页底部 iframe（https://hn.leitesoft.cn:8031/HN/*.html）页面 JS 中提取后填写
HUNAN_AIR_API_PASSWORD=

