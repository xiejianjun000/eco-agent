{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "options": {
    "typeAware": false
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "**/.sessions/**",
    ".claude/**",
    "**/.doc-typecheck-*/**",
    "**/.node-next-types-*/**",
    "website/.generated/**",
    "vendor/**",
    "native/**",
    "**/*.js",
    "**/*.mjs",
    "**/*.config.ts",
    "packages/client/tsdown.client.ts",
    // Same exemption as .oxlintrc.json: this list replaces rather than extends
    // the base ignorePatterns, so the ported community IM sources stay exempt
    // here too (adaptation keeps upstream style until a later lint pass).
    "packages/im/**"
  ]
}
