# Kimi (Moonshot) LLM 配置
KIMI_API_KEY=sk-your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5

# SecureStore 主密钥（不设置则每次启动随机生成并告警，历史密文将无法解密）
ECO_MASTER_KEY=change-me-to-a-long-random-string

# ── 秘钥管理（SPEC-r13 任务 D）──────────────────────────────
# 秘钥后端：env（默认，直读环境变量）| file（AES-GCM 加密文件库，需 ECO_MASTER_KEY）| vault（HashiCorp Vault）
# ECO_SECRET_BACKEND=env
# file 后端：秘钥库路径默认 ~/.eco/keystore.enc，权限强制 0600；ECO_MASTER_KEY 见上方说明（PBKDF2 派生）
# vault 后端：HashiCorp Vault KV v2
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=hvs-your-vault-token

# 网关配置（可选）
# ECO_GATEWAY_PORT=8765
# 一键禁用 LLM（离线/测试模式）
# ECO_LLM_DISABLE=1
