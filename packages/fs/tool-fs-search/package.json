{
  "name": "@eco-agent/dsh-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@eco-agent/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-output-retention": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-spill": "workspace:*",
    "@eco-agent/dsh-subprocess": "workspace:*",
    "@eco-agent/dsh-system-prompt": "workspace:*",
    "@eco-agent/dsh-timeout": "workspace:*",
    "@eco-agent/dsh-tools": "workspace:*",
    "@eco-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-subprocess": "workspace:*",
    "@eco-agent/dsh-subprocess-local": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-output-retention": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-spill": "workspace:*",
    "@eco-agent/dsh-system-prompt": "workspace:*",
    "@eco-agent/dsh-timeout": "workspace:*",
    "@eco-agent/dsh-tools": "workspace:*",
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-scope": "workspace:*"
  }
}
