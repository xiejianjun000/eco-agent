    "@eco-agent/dsh-host-directory-picker-browse": "workspace:*",
    "@eco-agent/dsh-host-directory-picker-native": "workspace:*",
    "@eco-agent/dsh-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/cordis-plugin-include": "workspace:~",
    "@eco-agent/cordis-plugin-loader": "workspace:~",
    "@eco-agent/dsh-client-ui-directory-picker-browse": "workspace:*",
    "@eco-agent/dsh-client-ui-directory-picker-native": "workspace:*",
    "@eco-agent/dsh-host-directory-picker": "workspace:*",
    "@eco-agent/dsh-host-directory-picker-browse": "workspace:*",
    "@eco-agent/dsh-host-directory-picker-native": "workspace:*",
    "@eco-agent/dsh-host-webserver": "workspace:*"
  },
  "dependencies": {
    "@eco-agent/dsh-launch-environment": "workspace:*"
