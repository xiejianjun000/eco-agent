{
  "name": "@eco-agent/dsh-llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the DeepSeek Harness LLM seam (design-verification twin of dsh-llm-deepseek)",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-attachment": "workspace:*",
    "@eco-agent/dsh-authorization": "workspace:*",
    "@eco-agent/dsh-credentials": "workspace:*",
    "@eco-agent/dsh-fs": "workspace:*",
    "@eco-agent/dsh-launch-environment": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-timeout": "workspace:*",
    "@eco-agent/cordis-plugin-loader": "workspace:~"
  },
  "dependencies": {
    "@eco-agent/dsh-brand": "workspace:*",
    "@eco-agent/dsh-util-values": "workspace:*",
    "@eco-agent/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-attachment": "workspace:*",
    "@eco-agent/dsh-authorization": "workspace:*",
    "@eco-agent/dsh-credentials": "workspace:*",
    "@eco-agent/dsh-fs": "workspace:*",
    "@eco-agent/dsh-launch-environment": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-llm-deepseek": "workspace:*",
    "@eco-agent/dsh-llm-deepseek-api-key": "workspace:*",
    "@eco-agent/dsh-timeout": "workspace:*",
    "@eco-agent/dsh-http-proxy": "workspace:*",
    "@eco-agent/cordis-plugin-loader": "workspace:~",
    "@eco-agent/dsh-settings": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@eco-agent/cordis-plugin-loader": {
      "optional": true
    }
  }
}
