{
  "name": "@eco-agent/dsh-client-ui-settings-eco-assistants",
  "description": "eco Agent「我的助手」设置页：微信助手（扫码登录 + 白名单 + 开关）与飞书助手的配置入口",
  "version": "0.1.7-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/client/ui-settings-eco-assistants"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@eco-agent/dsh-client-ui-settings",
        "@eco-agent/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:^"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:^",
    "@eco-agent/dsh-api-remotes": "workspace:^",
    "@eco-agent/dsh-client-locale": "workspace:^",
    "@eco-agent/dsh-client-store": "workspace:^",
    "@eco-agent/dsh-client-ui-primitives": "workspace:^",
    "@eco-agent/dsh-client-ui-renderer": "workspace:^",
    "@eco-agent/dsh-client-ui-settings": "workspace:^",
    "@eco-agent/dsh-client-ui-slots": "workspace:^",
    "@eco-agent/dsh-util-values": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
