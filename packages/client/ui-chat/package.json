{
  "name": "@eco-agent/dsh-client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@eco-agent/dsh-api-session-controller",
        "@eco-agent/dsh-api-workspace-controller",
        "@eco-agent/dsh-client-locale",
        "@eco-agent/dsh-client-ui-conversation",
        "@eco-agent/dsh-client-ui-input-trigger",
        "@eco-agent/dsh-client-ui-layout",
        "@eco-agent/dsh-client-ui-renderer",
        "@eco-agent/dsh-client-ui-session",
        "@eco-agent/dsh-client-ui-settings",
        "@eco-agent/dsh-client-ui-sidebar-right",
        "@eco-agent/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-api-remotes": "workspace:*",
    "@eco-agent/dsh-api-session-controller": "workspace:*",
    "@eco-agent/dsh-api-workspace-controller": "workspace:*",
    "@eco-agent/dsh-api-workspace-files": "workspace:*",
    "@eco-agent/dsh-attachment": "workspace:*",
    "@eco-agent/dsh-brand": "workspace:*",
    "@eco-agent/dsh-client-locale": "workspace:*",
    "@eco-agent/dsh-client-store": "workspace:*",
    "@eco-agent/dsh-client-ui-approval": "workspace:*",
    "@eco-agent/dsh-client-ui-conversation": "workspace:*",
    "@eco-agent/dsh-client-ui-input-trigger": "workspace:*",
    "@eco-agent/dsh-client-ui-layout": "workspace:*",
    "@eco-agent/dsh-client-ui-primitives": "workspace:*",
    "@eco-agent/dsh-client-ui-renderer": "workspace:*",
    "@eco-agent/dsh-client-ui-session": "workspace:*",
    "@eco-agent/dsh-client-ui-settings": "workspace:*",
    "@eco-agent/dsh-client-ui-sidebar-browser": "workspace:*",
    "@eco-agent/dsh-client-ui-sidebar-documentpreview": "workspace:*",
    "@eco-agent/dsh-client-ui-sidebar-right": "workspace:*",
    "@eco-agent/dsh-client-ui-slots": "workspace:*",
    "@eco-agent/dsh-client-ui-workspace": "workspace:*",
    "@eco-agent/dsh-commands": "workspace:*",
    "@eco-agent/dsh-compaction": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-llm-retry": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-session-stats": "workspace:*",
    "@eco-agent/dsh-session-turn-outline": "workspace:*",
    "@eco-agent/dsh-subagent": "workspace:*",
    "@eco-agent/dsh-token-meter": "workspace:*",
    "@eco-agent/dsh-tools": "workspace:*",
    "@eco-agent/dsh-util-workspace-path": "workspace:*",
    "@eco-agent/dsh-util-values": "workspace:*",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@eco-agent/dsh-settings": "workspace:*",
    "@eco-agent/dsh-client-product-analytics": "workspace:*"
  },
  "dependencies": {
    "@eco-agent/schemastery": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
