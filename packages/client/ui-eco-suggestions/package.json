{
  "name": "@eco-agent/dsh-client-ui-eco-suggestions",
  "description": "eco suggestion cards below the hero composer: six professional roles and the twelve-element coverage line",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-eco-suggestions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@eco-agent/dsh-client-locale",
        "@eco-agent/dsh-client-ui-conversation",
        "@eco-agent/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:^"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:^",
    "@eco-agent/dsh-client-locale": "workspace:^",
    "@eco-agent/dsh-client-ui-conversation": "workspace:^",
    "@eco-agent/dsh-client-ui-renderer": "workspace:^",
    "@eco-agent/dsh-client-ui-slots": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
