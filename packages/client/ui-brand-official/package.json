{
  "name": "@eco-agent/dsh-client-ui-brand-official",
  "description": "Official DeepSeek Harness brand occupants for the Web client's sidebar slots",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/client/ui-brand-official"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@eco-agent/dsh-client-ui-renderer",
        "@eco-agent/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@eco-agent/dsh-client-ui-primitives": "workspace:*",
    "@eco-agent/dsh-client-ui-renderer": "workspace:*",
    "@eco-agent/dsh-client-ui-sidebar": "workspace:*",
    "@eco-agent/cordis": "workspace:~",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
