{
  "name": "@eco-agent/dsh-client-ui-sidebar-eco-editor",
  "description": "Right-Sidebar document editor: edit a workspace file's whole text in place and save it through the ecoWorkspaceWrite write channel",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/client/ui-sidebar-eco-editor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@eco-agent/dsh-client-locale",
        "@eco-agent/dsh-api-workspace-files",
        "@eco-agent/dsh-api-eco-workspace-write",
        "@eco-agent/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": null,
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:^"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:^",
    "@eco-agent/dsh-api-eco-workspace-write": "workspace:^",
    "@eco-agent/dsh-api-gateway": "workspace:^",
    "@eco-agent/dsh-api-workspace-files": "workspace:^",
    "@eco-agent/dsh-client-locale": "workspace:^",
    "@eco-agent/dsh-client-store": "workspace:^",
    "@eco-agent/dsh-client-ui-primitives": "workspace:^",
    "@eco-agent/dsh-client-ui-sidebar-documentpreview": "workspace:^",
    "@eco-agent/dsh-client-ui-sidebar-right": "workspace:^",
    "@eco-agent/dsh-client-ui-slots": "workspace:^",
    "@eco-agent/dsh-session": "workspace:^",
    "@eco-agent/dsh-util-workspace-path": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ]
}
