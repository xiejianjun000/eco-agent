{
  "name": "@eco-agent/dsh-client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@eco-agent/dsh-api-workspace-controller",
        "@eco-agent/dsh-client-connection",
        "@eco-agent/dsh-client-locale",
        "@eco-agent/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@eco-agent/dsh-spill-policy": "workspace:*",
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-system-prompt": "workspace:*",
    "@eco-agent/dsh-tools": "workspace:*",
    "@eco-agent/dsh-tool-jobs": "workspace:*",
    "@eco-agent/dsh-tool-session-query": "workspace:*",
    "@eco-agent/dsh-tool-terminal": "workspace:*",
    "@eco-agent/dsh-spill": "workspace:*",
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-api-remotes": "workspace:*",
    "@eco-agent/dsh-client-connection": "workspace:*",
    "@eco-agent/dsh-client-locale": "workspace:*",
    "@eco-agent/dsh-client-test-runtime": "workspace:*",
    "@eco-agent/dsh-client-ui-conversation": "workspace:*",
    "@eco-agent/dsh-client-ui-primitives": "workspace:*",
    "@eco-agent/dsh-client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@eco-agent/dsh-api-workspace-controller": "workspace:*",
    "@eco-agent/dsh-client-ui-chat": "workspace:*",
    "@eco-agent/dsh-client-ui-renderer": "workspace:*",
    "@eco-agent/dsh-client-ui-session": "workspace:*",
    "@eco-agent/dsh-util-workspace-path": "workspace:*",
    "@eco-agent/dsh-attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@eco-agent/dsh-ptc-runtime": "workspace:*",
    "@eco-agent/dsh-token-meter": "workspace:*",
    "@eco-agent/dsh-user-questions": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
