{
  "name": "@eco-agent/dsh-client-ui-settings-eco-permission",
  "description": "eco Agent「权限与审批」设置页：新会话默认权限预设",
  "version": "0.2.0-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/client/ui-settings-eco-permission"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@eco-agent/dsh-client-ui-settings",
        "@eco-agent/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "peerDependencies": { "@eco-agent/cordis": "workspace:^" },
  "devDependencies": {
    "@eco-agent/dsh-client-locale": "workspace:^",
    "@eco-agent/dsh-client-ui-primitives": "workspace:^",
    "@eco-agent/dsh-client-ui-settings": "workspace:^",
    "@eco-agent/dsh-client-ui-slots": "workspace:^",
    "@eco-agent/dsh-client-store": "workspace:^",
    "@eco-agent/dsh-client-ui-renderer": "workspace:^",
    "@eco-agent/cordis": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [ "lib/index.js", "lib/client.js", "lib/types/**/*.d.ts" ]
}
