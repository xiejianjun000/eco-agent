{
  "name": "@eco-agent/dsh-client-ui-sidebar-eco-tabactions",
  "description": "eco Agent 右侧栏 tab 内容动作：复制文件路径 / 复制文件名 / 在文件管理器中显示（挂 tab 动作菜单，可插可拔）",
  "version": "0.1.7-alpha.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/client/ui-sidebar-eco-tabactions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@eco-agent/dsh-client-locale",
        "@eco-agent/dsh-client-ui-sidebar-right",
        "@eco-agent/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "peerDependencies": { "@eco-agent/cordis": "workspace:^" },
  "devDependencies": {
    "@eco-agent/dsh-api-gateway": "workspace:^",
    "@eco-agent/dsh-api-remotes": "workspace:^",
    "@eco-agent/dsh-api-session-controller": "workspace:^",
    "@eco-agent/dsh-client-locale": "workspace:^",
    "@eco-agent/dsh-client-modules": "workspace:^",
    "@eco-agent/dsh-client-store": "workspace:^",
    "@eco-agent/dsh-client-ui-primitives": "workspace:^",
    "@eco-agent/dsh-client-ui-renderer": "workspace:^",
    "@eco-agent/dsh-client-ui-sidebar-right": "workspace:^",
    "@eco-agent/dsh-client-ui-slots": "workspace:^",
    "@eco-agent/dsh-util-workspace-path": "workspace:^",
    "@eco-agent/cordis": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [ "lib/index.js", "lib/client.js", "lib/types/**/*.d.ts" ]
}
