{
  "name": "@eco-agent/dsh-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@eco-agent/cordis-plugin-timer": "workspace:~",
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-agent-loop": "workspace:*",
    "@eco-agent/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@eco-agent/dsh-invariants": "workspace:*",
    "@eco-agent/dsh-jobs-local": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-llm-deepseek-api-key": "workspace:*",
    "@eco-agent/dsh-llm-retry": "workspace:*",
    "@eco-agent/dsh-mcp-resources": "workspace:*",
    "@eco-agent/dsh-plugin-package-inventory-deepseek": "workspace:*",
    "@eco-agent/dsh-sandbox-local": "workspace:*",
    "@eco-agent/dsh-sandbox-policy": "workspace:*",
    "@eco-agent/dsh-scope": "workspace:*",
    "@eco-agent/dsh-sdk-app": "workspace:*",
    "@eco-agent/dsh-sdk-jsonrpc-server": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-session-log-deepseek": "workspace:*",
    "@eco-agent/dsh-session-persistence-jsonl": "workspace:*",
    "@eco-agent/dsh-session-projection": "workspace:*",
    "@eco-agent/dsh-session-title": "workspace:*",
    "@eco-agent/dsh-subprocess-local": "workspace:*",
    "@eco-agent/dsh-system-prompt": "workspace:*",
    "@eco-agent/dsh-terminal": "workspace:*",
    "@eco-agent/dsh-terminal-bash": "workspace:*",
    "@eco-agent/dsh-tool-bash-persistent": "workspace:*",
    "@eco-agent/dsh-tool-pwsh-persistent": "workspace:*",
    "@eco-agent/dsh-tools": "workspace:*"
  },
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:~"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:~"
  }
}
