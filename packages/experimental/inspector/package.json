{
  "name": "@eco-agent/dsh-experimental-inspector",
  "description": "Experimental cross-realm CDP hub for Host debugging and Client Runtime inspection",
  "version": "0.2.0-rc.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/inspector"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/worker.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@eco-agent/dsh-app-boot": "workspace:*",
    "@eco-agent/dsh-brand": "workspace:*",
    "@eco-agent/dsh-util-crypto": "workspace:*",
    "@eco-agent/schemastery": "workspace:~",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/cordis-plugin-loader": "workspace:~",
    "@eco-agent/dsh-client-modules": "workspace:*",
    "@eco-agent/dsh-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/cordis-plugin-include": "workspace:~",
    "@eco-agent/cordis-plugin-loader": "workspace:~",
    "@eco-agent/dsh-host-webserver": "workspace:*",
    "@types/ws": "^8.18.1",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2"
  }
}
