{
  "name": "@eco-agent/dsh-experimental-agent-team",
  "description": "Implicit-root Agent Teams roster, durable peer mailbox, and shared task DAG",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/experimental/agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@eco-agent/dsh-brand": "workspace:*",
    "@eco-agent/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-invariants": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-session-persistence": "workspace:*",
    "@eco-agent/dsh-session-projection": "workspace:*",
    "@eco-agent/dsh-subagent": "workspace:*"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-agent-loop": "workspace:*",
    "@eco-agent/dsh-agent-loop-testkit": "workspace:*",
    "@eco-agent/dsh-invariants": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-session-persistence": "workspace:*",
    "@eco-agent/dsh-session-persistence-jsonl": "workspace:*",
    "@eco-agent/dsh-session-projection": "workspace:*",
    "@eco-agent/dsh-session-query": "workspace:*",
    "@eco-agent/dsh-subagent": "workspace:*",
    "@eco-agent/dsh-subagent-fork-in-process": "workspace:*",
    "@eco-agent/dsh-subagent-spawn-in-process": "workspace:*"
  }
}
