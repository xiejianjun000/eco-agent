{
  "name": "@eco-agent/dsh-api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@eco-agent/dsh-api-gateway/client"
      ],
      "inject": [
        "@eco-agent/dsh-api-gateway",
        "@eco-agent/dsh-client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@eco-agent/dsh-brand": "workspace:*",
    "@eco-agent/dsh-deque": "workspace:*",
    "@eco-agent/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-agent-default-model": "workspace:*",
    "@eco-agent/dsh-agent-preset-registry": "workspace:*",
    "@eco-agent/dsh-api-gateway": "workspace:*",
    "@eco-agent/dsh-attachment": "workspace:*",
    "@eco-agent/dsh-client-connection": "workspace:*",
    "@eco-agent/dsh-client-file-upload": "workspace:*",
    "@eco-agent/dsh-commands": "workspace:*",
    "@eco-agent/dsh-credentials": "workspace:*",
    "@eco-agent/dsh-file-reference": "workspace:*",
    "@eco-agent/dsh-fs": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-native-command": "workspace:*",
    "@eco-agent/dsh-scope": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-session-persistence": "workspace:*",
    "@eco-agent/dsh-session-projection": "workspace:*",
    "@eco-agent/dsh-session-projection-cache": "workspace:*",
    "@eco-agent/dsh-session-query": "workspace:*",
    "@eco-agent/dsh-session-title": "workspace:*",
    "@eco-agent/dsh-settings": "workspace:*",
    "@eco-agent/dsh-skill": "workspace:*",
    "@eco-agent/dsh-subagent": "workspace:*",
    "@eco-agent/dsh-typert-protocol": "workspace:*",
    "@eco-agent/dsh-typert-registry": "workspace:*",
    "@eco-agent/dsh-util-time": "workspace:*",
    "@eco-agent/dsh-util-values": "workspace:*",
    "@eco-agent/dsh-util-workspace-path": "workspace:*",
    "@eco-agent/dsh-workspace": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@eco-agent/dsh-session-persistence": {
      "optional": true
    },
    "@eco-agent/dsh-session-projection-cache": {
      "optional": true
    },
    "@eco-agent/dsh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-agent-default-model": "workspace:*",
    "@eco-agent/dsh-agent-loop": "workspace:*",
    "@eco-agent/dsh-agent-loop-testkit": "workspace:*",
    "@eco-agent/dsh-agent-preset-registry": "workspace:*",
    "@eco-agent/dsh-api-gateway": "workspace:*",
    "@eco-agent/dsh-attachment": "workspace:*",
    "@eco-agent/dsh-client-connection": "workspace:*",
    "@eco-agent/dsh-client-file-upload": "workspace:*",
    "@eco-agent/dsh-client-store": "workspace:*",
    "@eco-agent/dsh-client-test-runtime": "workspace:*",
    "@eco-agent/dsh-commands": "workspace:*",
    "@eco-agent/dsh-credentials": "workspace:*",
    "@eco-agent/dsh-file-reference": "workspace:*",
    "@eco-agent/dsh-fs": "workspace:*",
    "@eco-agent/dsh-fs-local": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-native-command": "workspace:*",
    "@eco-agent/dsh-permission-presets": "workspace:*",
    "@eco-agent/dsh-remote-mock": "workspace:*",
    "@eco-agent/dsh-scope": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-session-persistence": "workspace:*",
    "@eco-agent/dsh-session-projection": "workspace:*",
    "@eco-agent/dsh-session-projection-cache": "workspace:*",
    "@eco-agent/dsh-session-query": "workspace:*",
    "@eco-agent/dsh-session-title": "workspace:*",
    "@eco-agent/dsh-settings": "workspace:*",
    "@eco-agent/dsh-skill": "workspace:*",
    "@eco-agent/dsh-storage": "workspace:*",
    "@eco-agent/dsh-storage-domain": "workspace:*",
    "@eco-agent/dsh-storage-json": "workspace:*",
    "@eco-agent/dsh-subagent": "workspace:*",
    "@eco-agent/dsh-typert-protocol": "workspace:*",
    "@eco-agent/dsh-typert-registry": "workspace:*",
    "@eco-agent/dsh-util-crypto": "workspace:*",
    "@eco-agent/dsh-util-time": "workspace:*",
    "@eco-agent/dsh-util-values": "workspace:*",
    "@eco-agent/dsh-util-workspace-path": "workspace:*",
    "@eco-agent/dsh-workspace": "workspace:*",
    "@types/mime-types": "^3.0.1"
  }
}
