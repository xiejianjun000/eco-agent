{
  "name": "@eco-agent/dsh-api-eco-workspace-write",
  "description": "Guarded workspace write channel: whole-file text writes and literal edits confined to one Session's workspace root, over the ecoWorkspaceWrite Remote namespace",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/api/eco-workspace-write"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@eco-agent/dsh-api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@eco-agent/dsh-typert-protocol": "workspace:^",
    "@eco-agent/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:^"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:^",
    "@eco-agent/dsh-api-gateway": "workspace:^",
    "@eco-agent/dsh-fs": "workspace:^",
    "@eco-agent/dsh-sandbox-policy": "workspace:^",
    "@eco-agent/dsh-session": "workspace:^",
    "@eco-agent/dsh-session-persistence": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
