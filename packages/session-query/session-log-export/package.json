{
  "name": "@eco-agent/dsh-session-log-export",
  "description": "Web Session-log export command and shared download dialog",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/session-query/session-log-export"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@eco-agent/dsh-session-format": "workspace:*",
    "@eco-agent/schemastery": "workspace:~",
    "fflate": "^0.8.2",
    "@eco-agent/dsh-brand": "workspace:*"
  },
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-session-persistence": "workspace:*"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/cordis-plugin-loader": "workspace:~",
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-attachment": "workspace:*",
    "@eco-agent/dsh-client-connection": "workspace:*",
    "@eco-agent/dsh-client-locale": "workspace:*",
    "@eco-agent/dsh-client-store": "workspace:*",
    "@eco-agent/dsh-client-ui-commands": "workspace:*",
    "@eco-agent/dsh-client-ui-conversation": "workspace:*",
    "@eco-agent/dsh-client-ui-message-feedback": "workspace:*",
    "@eco-agent/dsh-client-ui-primitives": "workspace:*",
    "@eco-agent/dsh-client-ui-renderer": "workspace:*",
    "@eco-agent/dsh-client-ui-session": "workspace:*",
    "@eco-agent/dsh-client-ui-slots": "workspace:*",
    "@eco-agent/dsh-commands": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-session-persistence": "workspace:*",
    "@eco-agent/dsh-session-query": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@eco-agent/dsh-client-locale",
        "@eco-agent/dsh-client-ui-commands",
        "@eco-agent/dsh-client-ui-conversation",
        "@eco-agent/dsh-client-ui-renderer",
        "@eco-agent/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  }
}
