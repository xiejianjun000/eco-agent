{
  "name": "@eco-agent/dsh-tools",
  "description": "Tool registry and execution pipeline for the DeepSeek Harness",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiejianjun000/eco-agent.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-ptc-runtime": "workspace:*",
    "@eco-agent/dsh-invariants": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-scope": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-system-prompt": "workspace:*",
    "@eco-agent/dsh-user-approval": "workspace:*",
    "@eco-agent/dsh-sandbox": "workspace:*",
    "@eco-agent/dsh-sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@eco-agent/dsh-brand": "workspace:*",
    "@eco-agent/dsh-util-values": "workspace:*",
    "@eco-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@eco-agent/cordis": "workspace:~",
    "@eco-agent/dsh-agent": "workspace:*",
    "@eco-agent/dsh-ptc-runtime": "workspace:*",
    "@eco-agent/dsh-invariants": "workspace:*",
    "@eco-agent/dsh-llm": "workspace:*",
    "@eco-agent/dsh-scope": "workspace:*",
    "@eco-agent/dsh-session": "workspace:*",
    "@eco-agent/dsh-session-projection": "workspace:*",
    "@eco-agent/dsh-system-prompt": "workspace:*",
    "@eco-agent/dsh-user-approval": "workspace:*",
    "@eco-agent/dsh-sandbox": "workspace:*",
    "@eco-agent/dsh-sandbox-policy": "workspace:*"
  }
}
