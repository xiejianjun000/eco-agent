+/**
+ * Render the eco logo (two-tone teal + lime).
+ * @param props.size - height in px (default 24; width keeps the 788:348 ratio).
+ * @param props.className - extra class for layout placement.
+ * @returns the eco logo svg (aria-hidden).
+ */
+export function EcoLogo({ size = 24, className }: IconProps) {
+  return (
+    <svg
+      width={(size * ECO_LOGO_VIEWBOX.width) / ECO_LOGO_VIEWBOX.height}
+      height={size}
+      className={className}
+      viewBox={`0 0 ${ECO_LOGO_VIEWBOX.width} ${ECO_LOGO_VIEWBOX.height}`}
+      fill="none"
+      aria-hidden="true"
+    >
+      <g fill="#0F766E">
+        {ECO_LOGO_PATHS.map(p => <path key={p.transform} d={p.d} transform={p.transform} />)}
+      </g>
+      <g fill="#96D562">
+        {ECO_LOGO_LEAF.map(p => <path key={p.transform} d={p.d} transform={p.transform} />)}
+      </g>
+    </svg>
+  )
+}
