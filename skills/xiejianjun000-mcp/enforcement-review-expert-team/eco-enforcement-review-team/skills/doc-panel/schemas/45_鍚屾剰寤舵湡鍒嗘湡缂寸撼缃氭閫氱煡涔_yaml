id: "45"
name: "同意延期/分期缴纳罚款通知书"
category: "行政处罚-执行"
complexity: "low"
template: "45_同意延期分期缴纳罚款通知书.md"
description: "生态环境主管部门同意当事人延期或分期缴纳罚款的文书"

fields:
  - id: "部门名称"
    key: "{{部门名称}}"
    type: "string"
    source: "系统配置.生态环境主管部门名称"
    required: true

  - id: "文号"
    key: "{{文号}}"
    type: "string"
    source: "系统数据.生成文号"
    required: true

  - id: "当事人名称"
    key: "{{当事人名称}}"
    type: "string"
    source: "案件数据.当事人.名称"
    required: true

  - id: "处罚决定书编号"
    key: "{{处罚决定书编号}}"
    type: "string"
    source: "案件数据.处罚决定书编号"
    required: true

  - id: "同意类型"
    key: "{{同意类型}}"
    type: "select"
    source: "用户输入"
    required: true
    options:
      - "延期缴纳"
      - "分期缴纳"

  - id: "延期或分期方案"
    key: "{{延期或分期方案}}"
    type: "text"
    source: "AI生成.从申请方案生成"
    required: true

  - id: "决定日期"
    key: "{{决定日期}}"
    type: "date"
    source: "系统数据.当前日期"
    required: true
