id: "16"
name: "授权委托书"
category: "行政处罚-调查取证"
complexity: "low"
template: "16_授权委托书.md"
description: "当事人委托他人代为处理行政处罚相关事务的授权文书（相对人参考填写）"

fields:
  - id: "委托人名称"
    key: "{{委托人名称}}"
    type: "string"
    source: "案件数据.当事人.名称"
    required: true

  - id: "委托人证件号码"
    key: "{{委托人证件号码}}"
    type: "string"
    source: "案件数据.当事人.证件号码"
    required: false

  - id: "委托人地址"
    key: "{{委托人地址}}"
    type: "string"
    source: "案件数据.当事人.地址"
    required: false

  - id: "受托人名称"
    key: "{{受托人名称}}"
    type: "string"
    source: "用户输入"
    required: true

  - id: "受托人证件号码"
    key: "{{受托人证件号码}}"
    type: "string"
    source: "用户输入"
    required: true

  - id: "委托事项"
    key: "{{委托事项}}"
    type: "text"
    source: "用户输入"
    required: true

  - id: "委托权限"
    key: "{{委托权限}}"
    type: "select"
    source: "用户输入"
    required: true
    options:
      - "一般代理"
      - "特别授权"

  - id: "委托期限"
    key: "{{委托期限}}"
    type: "string"
    source: "用户输入"
    required: true

  - id: "委托人签字日期"
    key: "{{委托人签字日期}}"
    type: "date"
    source: "用户输入"
    required: true

  - id: "受托人签字日期"
    key: "{{受托人签字日期}}"
    type: "date"
    source: "用户输入"
    required: true
