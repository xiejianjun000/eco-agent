id: "07"
name: "协助调查结果告知函"
category: "行政处罚-调查取证"
complexity: "low"
template: "07_协助调查结果告知函.md"
description: "协助调查的生态环境主管部门向请求单位回复调查结果的文书"

fields:
  - id: "部门名称"
    key: "{{部门名称}}"
    type: "string"
    source: "系统配置.生态环境主管部门名称"
    required: true

  - id: "文号"
    key: "{{文号}}"
    type: "string"
    source: "系统数据.生成文号"
    required: true

  - id: "请求协助单位"
    key: "{{请求协助单位}}"
    type: "string"
    source: "案件数据.协助调查.请求单位"
    required: true

  - id: "案件名称"
    key: "{{案件名称}}"
    type: "text"
    source: "案件数据.案由"
    required: true

  - id: "调查结果"
    key: "{{调查结果}}"
    type: "text"
    source: "AI生成.从调查记录生成调查结果"
    required: true

  - id: "附件材料"
    key: "{{附件材料}}"
    type: "text"
    source: "用户输入"
    required: false

  - id: "联系人"
    key: "{{联系人}}"
    type: "string"
    source: "系统数据.当前用户"
    required: true

  - id: "联系电话"
    key: "{{联系电话}}"
    type: "string"
    source: "系统数据.当前用户"
    required: true

  - id: "决定日期"
    key: "{{决定日期}}"
    type: "date"
    source: "系统数据.当前日期"
    required: true
