id: "18"
name: "抽样取证通知书"
category: "行政处罚-调查取证"
complexity: "low"
template: "18_抽样取证通知书.md"
description: "生态环境主管部门通知当事人进行抽样取证的文书"

fields:
  - id: "部门名称"
    key: "{{部门名称}}"
    type: "string"
    source: "系统配置.生态环境主管部门名称"
    required: true

  - id: "文号"
    key: "{{文号}}"
    type: "string"
    source: "系统数据.生成文号"
    required: true

  - id: "当事人名称"
    key: "{{当事人名称}}"
    type: "string"
    source: "案件数据.当事人.名称"
    required: true

  - id: "案由"
    key: "{{案由}}"
    type: "string"
    source: "案件数据.案由"
    required: true

  - id: "抽样时间"
    key: "{{抽样时间}}"
    type: "date"
    source: "系统数据.当前日期"
    required: true

  - id: "抽样地点"
    key: "{{抽样地点}}"
    type: "string"
    source: "案件数据.现场地址"
    required: true

  - id: "抽样物品清单"
    key: "{{抽样物品清单}}"
    type: "text"
    source: "用户输入"
    required: true

  - id: "决定日期"
    key: "{{决定日期}}"
    type: "date"
    source: "系统数据.当前日期"
    required: true
