      "credential": ["密码", "帐号", "账户", "用户"],
      "locked": ["锁定", "禁用", "冻结"]
    },
    "successMarkers": ["main", "home", "index"],
    "credentialKey": "atmosphere",
    "maxLoginAttempts": 3,
    "sessionTtlHours": 24
  },
  "water": {
