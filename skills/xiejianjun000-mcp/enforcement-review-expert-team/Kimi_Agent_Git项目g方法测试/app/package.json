{
  "name": "eco-aegis-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EcoAegis 生态环境执法办案评查一体化平台前端",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "type-check": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings src/",
    "preview": "vite preview --port 4173 --host"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.25.1",
    "oxlint": "^0.10.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^4.1.10"
  }
}
